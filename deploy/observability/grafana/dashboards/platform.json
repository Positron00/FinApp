    {
      "id": 15,
      "type": "timeseries",
      "title": "Memory (RSS) by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name, instance) (process_memory_usage_bytes)",
          "legendFormat": "{{service_name}} {{instance}}",
          "range": true,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (job) (process_resident_memory_bytes{job!=\"otel-collector\"})",
          "legendFormat": "{{job}}",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "Python services: process_memory_usage_bytes per process (OTel system metrics; web exports none; a stopped process's line ends after the Collector's 10 m metric expiry). Observability stack and exporters: process_resident_memory_bytes per scrape job.",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      }
    },
    {
