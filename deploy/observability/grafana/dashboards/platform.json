      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count by (service_name) (count by (service_name, instance) (count_over_time(process_cpu_time_seconds_total[1h])))",
