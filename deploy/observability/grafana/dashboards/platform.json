          "range": true,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (job) (changes(process_start_time_seconds[1h]))",
          "legendFormat": "{{job}} restarts",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "Python services: distinct processes seen in the last hour (each process has its own service.instance.id, so the count is the replica count plus one per restart). Stack components and exporters: changes of process_start_time_seconds. Kubernetes restarts are in the next row.",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      }
