{
  "uid": "payrun-platform",
  "title": "Platform",
  "tags": ["payrun"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Postgres and Redis exporters, service memory and restarts, Kubernetes pods (empty in Compose), the Collector's pipeline and scrape targets (platform LLD \u00a78.8).",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}",
        "step": "60s",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": ["payrun"],
      "asDropdown": true,
      "title": "PayRun dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Postgres (postgres-exporter)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Postgres up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "min(pg_up)",
          "legendFormat": "pg_up",
          "range": true,
          "exemplar": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 6
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Connections by role and state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (usename, state) (pg_stat_activity_count{datname=\"payrun\"})",
          "legendFormat": "{{usename}} {{state}}",
          "range": true,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max(pg_settings_max_connections)",
          "legendFormat": "max_connections",
          "range": true,
          "exemplar": false
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 10,
        "h": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Transactions per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0
