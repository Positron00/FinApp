      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(pg_stat_database_deadlocks{datname=\"payrun\"}[$__rate_interval]))",
          "legendFormat": "deadlocks",
          "range": true,
          "exemplar": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      }
    },
