{
  "uid": "payrun-queues",
  "title": "Queues and workers",
  "tags": ["payrun"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Payout stream throughput, lag, DLQ and processing time; outbox age; re-publishes, stuck and needs_operator attempts; late settlements (platform LLD \u00a78.8; PAY-NFR-10, 11).",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}",
        "step": "60s",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": ["payrun"],
      "asDropdown": true,
      "title": "PayRun dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Payout stream (stream:payout.requested, group payout-worker)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Messages handled by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(queue_messages_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "queue_messages_total: ok, retry, dlq (pre-initialised at 0, C21).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Processing time p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(queue_processing_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(queue_processing_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "exemplar": true
        }
      ],
      "description": "queue_processing_seconds; exemplars link to the consume span.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumer lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (stream, group) (queue_consumer_lag)",
          "legendFormat": "{{group}} (worker)",
          "range": true,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (stream, group) (redis_stream_group_lag)",
          "legendFormat": "{{group}} (redis-exporter)",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "Entries not yet delivered to the group. ConsumerLagGrowing opens a ticket when it keeps growing for 10 minutes. The exporter line still shows when the worker is down.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dead-lettered messages",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(clamp_min(last_over_time(queue_messages_total{outcome=\"dlq\"}[15m]) - max_over_time(queue_messages_total{outcome=\"dlq\"}[1h] offset 15m), 0) or (last_over_time(queue_messages_total{outcome=\"dlq\"}[15m]) unless max_over_time(queue_messages_total{outcome=\"dlq\"}[1h] offset 15m))) or vector(0)",
          "legendFormat": "dlq in last 15 m (PayoutDLQ)",
          "range": true,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (stream) (queue_dlq_messages)",
          "legendFormat": "{{stream}} length",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "PayoutDLQ pages on any increase over 15 minutes, or on a new series already above 0 (no sample in the hour before the window; C75). Follow docs/runbooks/PayoutDLQ.md to replay or purge.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stream length",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
