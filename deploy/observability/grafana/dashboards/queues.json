      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (stream) (redis_stream_length)",
          "legendFormat": "{{stream}}",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "redis_stream_length for both streams; PayoutStreamNearMaxlen above 80% of STREAM_MAXLEN (80000).",
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 7,
      "type": "timeseries",
