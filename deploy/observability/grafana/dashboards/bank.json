          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (outcome, reason) (increase(payouts_bank_transfers_total[$__rate_interval]))",
          "legendFormat": "{{outcome}} {{reason}}",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "payouts_bank_transfers_total: settled, rejected (account_closed, insufficient_funds_at_bank, other), no_answer, not_found.",
