{
  "uid": "payrun-bank",
  "title": "Bank (stub) dependency",
  "tags": ["payrun"],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "External calls from payout-worker to the bank and to payroll: requests, errors, latency, breaker state, and the bank's classified answers (platform LLD \u00a78.8).",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}",
        "step": "60s",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": ["payrun"],
      "asDropdown": true,
      "title": "PayRun dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Bank (payout-worker -> bank-stub)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(external_requests_total{provider=\"bank\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "external_requests_total per attempt: ok, client_error, rate_limited, server_error, timeout, connect_error, breaker_open (C55). A bank business rejection is HTTP 2xx and counts as ok.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "provider:external_errors:ratio_rate5m{provider=\"bank\"}",
          "legendFormat": "error ratio (5 m)",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "Non-ok attempts / all attempts. BankErrorRateHigh opens a ticket above 5% for 10 minutes.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(external_request_duration_seconds_bucket{provider=\"bank\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(external_request_duration_seconds_bucket{provider=\"bank\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(external_request_duration_seconds_bucket{provider=\"bank\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "exemplar": true
        }
      ],
      "description": "external_request_duration_seconds per attempt; exemplars link to the client span.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Breaker state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green"
                },
                "1": {
                  "text": "half-open",
                  "color": "yellow"
                },
                "2": {
                  "text": "open",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (target) (circuit_breaker_state{service_name=\"payout-worker\",target=\"bank\"})",
          "legendFormat": "{{target}}",
          "range": true,
          "exemplar": false
        }
      ],
      "description": "0 closed, 1 half-open, 2 open. BankBreakerOpen opens a ticket after 5 minutes open.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 6
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by operation",
      "datasource": {
        "type": "prometheus",
