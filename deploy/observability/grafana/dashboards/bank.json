    {
      "id": 17,
      "type": "logs",
      "title": "Bank events",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=~\"payout-worker|bank-stub\"} | event=~\"(bank|bank_stub)[.]transfer[.].*|external[.](breaker|request)[.].*\""
        }
      ],
      "description": "bank.transfer.submitted, bank.transfer.rejected, bank.transfer.no_answer, external.breaker.opened, ...",
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 8
