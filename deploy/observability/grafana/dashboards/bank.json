      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"payout-worker\" && status=error}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 8
      }
    }
