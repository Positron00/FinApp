# PayRun dev and CI settings (platform LLD §3.15, §4; PAY-NFR-13).
#
# Don't copy this file by hand: run scripts/dev-env.sh, which writes the git-ignored .env (mode
# 0600) with fresh random secrets and derived values, and never prints them. This file only
# documents every key. Secrets are left empty here on purpose; nothing in it is a real value.
# Encoding in .env: PEMs are double-quoted with \n escapes; JSON values are single-quoted.

# --- general (kept) --------------------------------------------------------------------------
# Environment name; seed.py and mint_token.py refuse anything but dev.
ENV=dev
# Compose project name (container and network prefix).
COMPOSE_PROJECT_NAME=payrun
# Base for every published 127.0.0.1 port (C4, C12); the ports below are derived from it.
APP_PORT_BASE=4100
# The one dev company (C28); also in the event-schema examples.
COMPANY_ID=0193a000-0000-7000-8000-000000000001

# --- derived on every dev-env.sh run -----------------------------------------------------------
# Image tag and OTel service.version: `git rev-parse --short HEAD`, else "dev".
APP_VERSION=dev
# base+0 web, +1 Grafana, +2 Mailpit UI
WEB_PORT=4100
GRAFANA_PORT=4101
MAILPIT_PORT=4102
# base+10..13: services, published by compose.test.yaml for host-run tests
IDENTITY_PORT=4110
PAYROLL_PORT=4111
PAYOUT_WORKER_PORT=4112
BANK_STUB_PORT=4113
# base+30..35: Tempo, Loki, Prometheus, Alertmanager, Toxiproxy API, alert-sink (test profile)
TEMPO_PORT=4130
LOKI_PORT=4131
PROMETHEUS_PORT=4132
ALERTMANAGER_PORT=4133
TOXIPROXY_PORT=4134
ALERT_SINK_PORT=4135
# Public-key sets built from the private keys below: identity trusts web; payroll trusts web and
# payout-worker. JSON: {"<kid>": {"iss": "web", "pem": "<public PEM>"}}
IDENTITY_INTERNAL_JWT_PUBLIC_KEYS=
PAYROLL_INTERNAL_JWT_PUBLIC_KEYS=

# --- Postgres (hex secrets, kept) ----------------------------------------------------------------
# Superuser for the bootstrap SQL (deploy/compose/init).
POSTGRES_PASSWORD=
# <schema>_migrator (migrations, bootstrap-owner) and <schema>_app (runtime) per service (C2).
IDENTITY_DB_MIGRATOR_PASSWORD=
IDENTITY_DB_PASSWORD=
PAYROLL_DB_MIGRATOR_PASSWORD=
PAYROLL_DB_PASSWORD=
PAYOUTS_DB_MIGRATOR_PASSWORD=
PAYOUTS_DB_PASSWORD=
BANK_STUB_DB_MIGRATOR_PASSWORD=
BANK_STUB_DB_PASSWORD=
# postgres_exporter role (pg_monitor only).
POSTGRES_EXPORTER_PASSWORD=

# --- Redis ACL users (hex secrets, kept; deploy/compose/redis) -----------------------------------
REDIS_ADMIN_PASSWORD=
REDIS_WEB_PASSWORD=
REDIS_IDENTITY_PASSWORD=
REDIS_PAYROLL_PASSWORD=
REDIS_PAYOUT_WORKER_PASSWORD=
REDIS_EXPORTER_PASSWORD=

# --- internal JWT signing keys (Ed25519 PKCS8 PEM, kept) -----------------------------------------
# The web signs user and service:web tokens.
INTERNAL_JWT_PRIVATE_KEY=
# dev-web-<YYYYMMDD>
INTERNAL_JWT_KID=
# payout-worker signs its calls to payroll's internal routes.
PAYOUT_WORKER_JWT_PRIVATE_KEY=
# dev-worker-<YYYYMMDD>
PAYOUT_WORKER_JWT_KID=

# --- other application secrets (kept) ------------------------------------------------------------
# payroll field encryption keyring, JSON {"dev-1": "<base64 32 bytes>"}, and the active kid.
PAYROLL_FIELD_KEYS=
PAYROLL_FIELD_ACTIVE_KID=dev-1
# identity: HMAC key for hashing client IPs in the audit log (base64 32 bytes).
AUDIT_IP_HASH_KEY=
# web: session HMAC secret (base64 48 bytes).
SESSION_SECRET=
# bank-stub API key, also sent by payout-worker (hex 32 bytes).
BANK_STUB_API_KEY=
# Grafana admin user "admin".
GRAFANA_ADMIN_PASSWORD=

# --- infrastructure (kept) -----------------------------------------------------------------------
# identity's SMTP relay: Mailpit in dev, no credentials (C49).
SMTP_HOST=mailpit
SMTP_PORT=1025
# Alertmanager receivers; dev and CI point both at alert-sink.
ALERT_PAGE_WEBHOOK_URL=http://alert-sink:8080/page
ALERT_TICKET_WEBHOOK_URL=http://alert-sink:8080/ticket
# Every service and environment (C23); there is no OTEL_TRACES_SAMPLER_ARG.
OTEL_TRACES_SAMPLER=parentbased_always_on

# --- seed, e2e and load accounts (kept; C27, C59, R16, R22) --------------------------------------
# The active owner created by the bootstrap-owner one-shot with SEED_OWNER_PASSWORD.
SEED_OWNER_EMAIL=owner@payrun.example.com
SEED_OWNER_PASSWORD=
# approver@payrun.example.com (approves in the skeleton journey and settlement.js).
SEED_APPROVER_PASSWORD=
# k6 user, role payroll_admin only.
LOAD_USER_EMAIL=load@payrun.example.com
LOAD_USER_PASSWORD=
