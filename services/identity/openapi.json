            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "roles",
          "roles_version",
          "status",
          "created_at",
          "updated_at",
          "activated_at",
          "deactivated_at",
          "pending_invite_id",
          "company_id"
